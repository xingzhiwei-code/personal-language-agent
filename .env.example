# ---------------------------------------------------------------------------
# Personal Language Learning Agent — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real keys.
# The app is fully usable WITHOUT any AI key:
#   history, knowledge base, deterministic review, scheduling and learner state
#   never require an LLM.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Turso (cloud SQLite) is the single source of truth for the deployed app.
# When TURSO_DATABASE_URL is set (and TURSO_AUTH_TOKEN for auth), the app and
# every script connect to Turso automatically. Migrate with `npm run db:migrate`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite file — offline escape hatch ONLY (default: ./data/app.db).
# Ignored whenever TURSO_DATABASE_URL is set.
LLA_DB_PATH=./data/app.db

# Local object storage root (default: ./data/objects)
LLA_STORAGE_DIR=./data/objects

# --- LLM provider (optional) ------------------------------------------------
# DeepSeek, OpenAI-compatible chat-completions endpoint (existing provider,
# zero code changes). Leave LLA_LLM_API_KEY empty to run in "no-AI" mode.
# NOTE: the model must be `deepseek-flash`; the old alias `deepseek-v4-flash`
# was retired in 2026-09 and is no longer accepted.
LLA_LLM_BASE_URL=https://api.deepseek.com
LLA_LLM_API_KEY=
LLA_LLM_MODEL=deepseek-flash
LLA_LLM_TIMEOUT_MS=20000
